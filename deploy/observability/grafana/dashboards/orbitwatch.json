{
 "title": "OrbitWatch pipeline",
 "uid": "orbitwatch",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS",
    "type": "datasource",
    "query": "prometheus",
    "current": {
     "text": "Prometheus",
     "value": "Prometheus"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Propagation tick duration (s)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "orbitwatch_propagation_tick_seconds_max",
     "legendFormat": "max",
     "refId": "A"
    },
    {
     "expr": "rate(orbitwatch_propagation_tick_seconds_sum[1m])/rate(orbitwatch_propagation_tick_seconds_count[1m])",
     "legendFormat": "mean",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "State vectors produced /s",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "rate(orbitwatch_propagation_vectors_total[1m])",
     "legendFormat": "vectors/s",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Catalogue size / objects per tick",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "orbitwatch_propagation_catalog_size",
     "legendFormat": "catalog",
     "refId": "A"
    },
    {
     "expr": "orbitwatch_propagation_last_tick_objects",
     "legendFormat": "propagated",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Ingest: published vs unchanged (per run)",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "increase(orbitwatch_ingest_gp_published_total[1h])",
     "legendFormat": "published",
     "refId": "A"
    },
    {
     "expr": "increase(orbitwatch_ingest_gp_unchanged_total[1h])",
     "legendFormat": "unchanged",
     "refId": "B"
    },
    {
     "expr": "increase(orbitwatch_ingest_gp_fetch_failures_total[1h])",
     "legendFormat": "fetch failures",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Kafka Streams: records processed /s (analytics)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum(rate(kafka_stream_thread_process_total[1m]))",
     "legendFormat": "process/s",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "JVM heap used by service",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum by (service) (jvm_memory_used_bytes{area=\"heap\"})",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Gateway HTTP p95 latency",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le,uri) (rate(http_server_requests_seconds_bucket{service=\"gateway\"}[5m])))",
     "legendFormat": "{{uri}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Consumer lag (analytics)",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "expr": "sum by (topic) (kafka_consumer_fetch_manager_records_lag_max{service=\"analytics\"})",
     "legendFormat": "{{topic}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   }
  }
 ],
 "tags": [
  "orbitwatch"
 ]
}