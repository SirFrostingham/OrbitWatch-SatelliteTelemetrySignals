        <mxCell id="c3_1" value="tick" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="310" width="130" height="60" as="geometry"/></mxCell>
        <mxCell id="c3_2" value="Fleet statistics per tick" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="310" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="c3_3" value="1 / 24 h" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="310" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="c3_4" value="analytics → gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="310" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="c4_0" value="ow.analytics.alerts.v1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="c4_1" value="alert id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="370" width="130" height="60" as="geometry"/></mxCell>
        <mxCell id="c4_2" value="Operator alerts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="370" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="c4_3" value="6 / 7 d" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="370" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="c4_4" value="analytics, ingest, propagation → gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="370" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="c5_0" value="ow.ops.ingest-runs.v1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="c5_1" value="run id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="430" width="130" height="60" as="geometry"/></mxCell>
        <mxCell id="c5_2" value="Ingest observability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="430" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="c5_3" value="1 / 7 d" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="430" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="c5_4" value="ingest → gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="430" width="330" height="60" as="geometry"/></mxCell>
        <mxCell id="note2" value="Why keys are NORAD ids: every event for one object lands on one partition, so ordering per object&lt;br&gt;is guaranteed and consumers shard by partition.&lt;br&gt;&lt;br&gt;Why compaction: a compacted topic IS the table. A restarted service replays it to rebuild state -&lt;br&gt;no database, and an ingest restart republishes nothing.&lt;br&gt;&lt;br&gt;Versioning: additive optional fields never bump the version (unknown properties are ignored, so old&lt;br&gt;consumers tolerate new producers). A breaking change is a new .v2 topic with a bridge - never an&lt;br&gt;in-place mutation.&lt;br&gt;&lt;br&gt;JSON, not Avro: readable in Kafka UI during a demo, no schema registry to operate; the contract&lt;br&gt;module plus round-trip tests supply the compatibility discipline. The trade-off flips with external&lt;br&gt;consumers or 10x the volume." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1310" height="250" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 Analytics topology" id="3-analytics-topology">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="a_title" value="analytics-service — Kafka Streams topology (event time = the tick, so windows align regardless of publish latency)" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="in_sv" value="ow.telemetry.state-vectors.v1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="in_gp" value="ow.catalog.gp-elements.v1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="acc" value="TickAccumulator&lt;br&gt;per-partition processor, in-memory fold,&lt;br&gt;one partial per tick on punctuation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="100" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="rep" value="repartition → 1 partition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="110" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="merge" value="merge partials&lt;br&gt;drops stragglers already published" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="100" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="out_stats" value="ow.analytics.tick-stats.v1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="110" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="ghost" value="flatMap to cell keys&lt;br&gt;50 km cells + ghost copies for&lt;br&gt;neighbours within 10 km" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="230" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="win" value="window(tick) per cell&lt;br&gt;+ grace 5 s + suppress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="235" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="screen" value="screen bucket locally&lt;br&gt;pair reported once, in the own&lt;br&gt;cell of the lower NORAD id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="230" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="stale" value="filter: element epoch &gt; 30 days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="380" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="decay" value="DecayWatch&lt;br&gt;perigee &lt; 250 km, or B* &gt; 5e-3&lt;br&gt;with perigee &lt; 300 km" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="480" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="man" value="ManeuverDetector&lt;br&gt;compares consecutive element sets&lt;br&gt;against the set's own drag term" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="610" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="man_store" value="store:&lt;br&gt;last element set&lt;br&gt;per object" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="610" width="170" height="90" as="geometry"/></mxCell>
        <mxCell id="dedupe" value="AlertDeduper&lt;br&gt;same dedupeKey not re-emitted&lt;br&gt;within 30 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="420" width="230" height="90" as="geometry"/></mxCell>
        <mxCell id="dedupe_store" value="store:&lt;br&gt;last emit per&lt;br&gt;dedupeKey" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="550" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="out_alerts" value="ow.analytics.alerts.v1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="430" width="210" height="70" as="geometry"/></mxCell>
        <mxCell id="note3" value="Two-stage aggregation is the point of the top row: the naive groupBy(tick) funnels 16.5k records per&lt;br&gt;tick through one key, one partition and one thread and fell 100k records behind. Per-partition partials&lt;br&gt;plus a single-partition merge fixed it.&lt;br&gt;&lt;br&gt;Conjunction screening is O(N.k) instead of O(N^2) (136 M pairs per tick): space is the partition key.&lt;br&gt;Validated against brute force in ConjunctionScreenerTest.&lt;br&gt;&lt;br&gt;Stores marked in orange are Kafka-backed (RocksDB + changelog), so suppression and manoeuvre history&lt;br&gt;survive restarts and rebalances. The accumulators are deliberately in-memory: derived, cheap to recompute." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1350" height="190" as="geometry"/></mxCell>
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="in_sv" target="acc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="one partial&lt;br&gt;per tick" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="acc" target="rep"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="rep" target="merge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="merge" target="out_stats"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="in_sv" target="ghost"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="ghost" target="win"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a7" value="window closes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="win" target="screen"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a8" value="CONJUNCTION" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="screen" target="dedupe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="in_sv" target="stale"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a10" value="STALE_ELEMENTS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="stale" target="dedupe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="in_gp" target="decay"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a12" value="DECAY_WATCH" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="decay" target="dedupe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="in_gp" target="man"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="man" target="man_store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a15" value="MANEUVER_CANDIDATE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="man" target="dedupe"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="dedupe" target="dedupe_store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="dedupe" target="out_alerts"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4 Resilience" id="4-resilience">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="r_title" value="Failure is designed for: the fetch ladder on the left, and the rule that readiness means producing on the right" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="r_b1" value="ingest fetch ladder — first one that works wins, and the choice is visible" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="520" height="620" as="geometry"/></mxCell>
        <mxCell id="f1" value="1. live fetch from CelesTrak&lt;br&gt;HTTP/1.1, 3 attempts, backoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="f2" value="2. cache, if inside the 2 h&lt;br&gt;provider minimum interval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="240" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="f3" value="3. stale cache&lt;br&gt;WARN + fetch_failures metric" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="340" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="f4" value="4. committed snapshot in data/&lt;br&gt;WARN + seed_fallbacks metric&lt;br&gt;+ health detail: degraded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="440" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="f5" value="5. fail the run&lt;br&gt;readiness DOWN, error on the&lt;br&gt;ops topic, container unhealthy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="r1" value="unreachable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r2" value="expired" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r3" value="no cache at all" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r4" value="no snapshot either" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_b2" value="readiness means producing (ADR-0008) — a green health check must mean work is happening" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="600" y="90" width="760" height="300" as="geometry"/></mxCell>
        <mxCell id="h1" value="ingest readiness DOWN&lt;br&gt;when the last GP or SATCAT run failed&lt;br&gt;→ container (unhealthy), error in health details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="140" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="h2" value="analytics readiness DOWN&lt;br&gt;when the Streams client is not RUNNING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="260" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="h3" value="analytics exits with code 70&lt;br&gt;on Streams ERROR → the orchestrator restarts it,&lt;br&gt;so a permanent fault is a visible restart loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="330" height="90" as="geometry"/></mxCell>
        <mxCell id="h4" value="JVM: -XX:+ExitOnOutOfMemoryError&lt;br&gt;container mem_limit, heap 65% of it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="260" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="r_b3" value="other guarantees, each with a unit test and a line on the runbook alarm checklist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="600" y="420" width="760" height="290" as="geometry"/></mxCell>
        <mxCell id="g1" value="cache write failure falls back to memory&lt;br&gt;an optimisation can never fail the main path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="470" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="g2" value="tick deferred (&lt;= 3) while element sets&lt;br&gt;are still arriving - no partial snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="560" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="g3" value="AlertDeduper survives restarts&lt;br&gt;no alert storm after a rebalance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="470" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="g4" value="every service rebuilds state from Kafka&lt;br&gt;restart is not a recovery procedure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="560" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="note4" value="Each of these exists because it was observed, not imagined. 2026-09-10: a root-owned cache volume turned a&lt;br&gt;successful fetch into a failed run; the same ownership bug would have crash-looped analytics; behind that,&lt;br&gt;RocksDB's native library could not load on Alpine, so Streams shut down while the web server kept passing health&lt;br&gt;checks; behind that, JVMs without container memory limits were being OOM-killed. Every container was green.&lt;br&gt;The next day CelesTrak was unreachable from the operator's network entirely - plain HTTP failed too - which is&lt;br&gt;why the ladder on the left ends in a committed snapshot rather than an empty catalogue." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="1320" height="170" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5 Build and deployment" id="5-build-and-deployment">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="d_title" value="One Dockerfile, three deployment targets — broker configuration stays in environment variables, never in code" style="text;html=1;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="d_b1" value="docker build --build-arg SERVICE=..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="500" height="290" as="geometry"/></mxCell>
        <mxCell id="s1" value="stage 1: node:22-alpine&lt;br&gt;builds the React/TS dashboard into&lt;br&gt;the gateway's static resources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="s2" value="stage 2: maven:3.9-temurin-21&lt;br&gt;builds the whole reactor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="220" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="stage 3: eclipse-temurin:21-jre-alpine&lt;br&gt;non-root user, HEALTHCHECK, libstdc++&lt;br&gt;for RocksDB's native library" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="d1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_b2" value="local — docker compose" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="90" width="380" height="290" as="geometry"/></mxCell>
        <mxCell id="l1" value="start.cmd / start.sh&lt;br&gt;picks free host ports, writes .env,&lt;br&gt;waits for every container healthy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="140" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="l2" value="5 containers + kafka-ui&lt;br&gt;(+ Prometheus and Grafana under&lt;br&gt;the observability profile)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="610" y="240" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="d3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_b3" value="OCI — single VM (Terraform)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="360" height="290" as="geometry"/></mxCell>
        <mxCell id="v1" value="VCN, public subnet, security list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="140" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="v2" value="Ampere A1 instance (Always-Free shape)&lt;br&gt;cloud-init installs Docker, clones the&lt;br&gt;repo, runs compose + observability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="210" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="d4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="v1" target="v2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_b4" value="OCI — OKE (kustomize)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="660" height="300" as="geometry"/></mxCell>
        <mxCell id="k1" value="base: 4 Deployments with liveness and&lt;br&gt;readiness probes, Prometheus scrape&lt;br&gt;annotations, single-node Kafka StatefulSet,&lt;br&gt;OCI flexible Load Balancer for the gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="470" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="k2" value="overlay oke-oci-streaming:&lt;br&gt;deletes the in-cluster broker and points&lt;br&gt;every service at OCI Streaming&lt;br&gt;(Kafka-compatible, SASL_SSL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="470" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="k3" value="The only change is environment variables:&lt;br&gt;KAFKA_BOOTSTRAP_SERVERS, KAFKA_SECURITY_PROTOCOL,&lt;br&gt;KAFKA_SASL_* — which is the point of keeping broker&lt;br&gt;configuration out of the code." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="70" y="600" width="600" height="90" as="geometry"/></mxCell>
        <mxCell id="d5" value="swap the broker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="k1" target="k2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_b5" value="CI — GitHub Actions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="740" y="420" width="620" height="300" as="geometry"/></mxCell>
        <mxCell id="c1" value="build the dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="470" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="c2" value="mvn verify — 138 tests, no broker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="540" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="c3" value="build the four service images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="610" width="260" height="50" as="geometry"/></mxCell>
        <mxCell id="c4" value="smoke test: start Kafka, run the services&lt;br&gt;offline, assert that tick statistics and&lt;br&gt;conjunction alerts actually flow&lt;br&gt;end to end" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="470" width="280" height="190" as="geometry"/></mxCell>
        <mxCell id="d6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=blockThin;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
